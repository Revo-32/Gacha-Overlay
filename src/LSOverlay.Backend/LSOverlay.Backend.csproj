<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LSOverlay.Backend</RootNamespace>
    <AssemblyName>LSOverlay.Backend</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GachaOverlay.Core\GachaOverlay.Core.csproj" />
    <ProjectReference Include="..\LSOverlay.Protocol\LSOverlay.Protocol.csproj" />
    <ProjectReference Include="..\LSOverlay.RemoteClient\LSOverlay.RemoteClient.csproj" />
    <ProjectReference Include="..\LSOverlay.CoreMedia\LSOverlay.CoreMedia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\GachaOverlay.Infrastructure\Sales\DefaultSalesProductCatalog.json" LogicalName="LSOverlay.CoreSales.Catalog.json" />
    <EmbeddedResource Include="..\GachaOverlay.Infrastructure\Localization\Resources\Strings.ko.resx" LogicalName="LSOverlay.CoreSales.Strings.ko.xml" WithCulture="false" Type="Non-Resx" />
    <Content Remove="PublicWeb\Content\**" />
    <Content Remove="Gta\Localization\gta-ko-overrides.json" />
    <EmbeddedResource Include="Gta\Localization\gta-ko-overrides.json" LogicalName="LSOverlay.GtaOverrides.json" />
    <EmbeddedResource Include="PublicWeb\Content\*" LogicalName="LSOverlay.PublicWeb.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\branding\LS_Overlay_logo.png" LogicalName="LSOverlay.PublicWeb.logo.png" />
  </ItemGroup>

</Project>
