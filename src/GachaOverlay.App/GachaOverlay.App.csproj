<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>LS Overlay</AssemblyTitle>
    <Product>LS Overlay</Product>
    <Description>LS Overlay</Description>
    <Copyright>Copyright (c) 2026 Gacha Overlay contributors</Copyright>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\Branding\LSOverlay-AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GachaOverlay.Core\GachaOverlay.Core.csproj" />
    <ProjectReference Include="..\GachaOverlay.Infrastructure\GachaOverlay.Infrastructure.csproj" />
    <ProjectReference Include="..\LSOverlay.RemoteClient\LSOverlay.RemoteClient.csproj" />
    <ProjectReference Include="..\LSOverlay.Protocol\LSOverlay.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\KIMM_Bold.ttf" />
    <Resource Include="Assets\Fonts\KIMM_Light.ttf" />
    <Resource Include="Assets\Fonts\Cafe24PROSlimMax.ttf" />
    <Resource Include="Assets\Fonts\Cafe24PROSlimFit.ttf" />
    <Resource Include="Assets\Fonts\PretendardVariable.ttf" />
    <Resource Include="Assets\Fonts\WantedSansVariable.ttf" />
    <Resource Include="Assets\Fonts\ChosunGu.TTF" />
    <Content Include="Assets\Fonts\KIMM_Bold.ttf"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\KIMM_Light.ttf"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\Cafe24PROSlimMax.ttf"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\Cafe24PROSlimFit.ttf"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\PretendardVariable.ttf"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\WantedSansVariable.ttf"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\ChosunGu.TTF"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\ThirdPartyNotices\**\*"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Themes\ThirdPartyNotices\**\*"
             Condition="'$(PublishSingleFile)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Branding\LSOverlay-AppIcon.ico" />
    <Resource Include="Assets\Branding\LSOverlay-AppIcon.png" />
  </ItemGroup>
</Project>
