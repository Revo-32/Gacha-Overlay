<UserControl x:Class="GachaOverlay.App.Presentation.SalesQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
             xmlns:sales="clr-namespace:GachaOverlay.Core.Sales;assembly=GachaOverlay.Core"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="SalesBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SalesSurfaceEffectiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SalesBorderEffectiveBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccentKind}"
                             Value="{x:Static sales:SalesQueueAccentKind.NextTurn}">
                    <Setter Property="Background" Value="{DynamicResource SalesNextSurfaceEffectiveBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccentKind}"
                             Value="{x:Static sales:SalesQueueAccentKind.CurrentTurn}">
                    <Setter Property="Background" Value="{DynamicResource SalesCurrentSurfaceEffectiveBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    <Border x:Name="QueueBar"
            Grid.Row="0"
            Margin="0,8,0,0"
            Padding="10,7"
            automation:AutomationProperties.Name="{Binding AccessibleStatus}"
            CornerRadius="{DynamicResource CornerRadius.Sales}"
            Style="{StaticResource SalesBarStyle}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolVisibility}}">
        <Grid ClipToBounds="True">
            <Border x:Name="AccentSweep"
                    Margin="-12,-9"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    CornerRadius="{DynamicResource CornerRadius.Sales}"
                    IsHitTestVisible="False"
                    Opacity="0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <local:SalesStatusIconHost x:Name="StatusIcon" Grid.Column="0" Margin="0,0,6,0" />

                <StackPanel x:Name="ContentHost" Grid.Column="1">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding PrimaryLine}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding SecondaryLine}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsSecondLineVisible, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <Button x:Name="QueueDetailToggle"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleDetailCommand}"
                        IsEnabled="{Binding IsQueueDetailInteractive}"
                        ToolTip="{Binding Localization[SalesQueueDetails]}"
                        Visibility="{Binding IsQueueDetailAvailable, Converter={StaticResource BoolVisibility}}">
                    <Path Data="M 1 3 L 5 7 L 9 3"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding DetailChevronAngle}" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>
        </Grid>
    </Border>

        <Border x:Name="QueueDetailPanel"
                Grid.Row="1"
                Margin="0,6,0,0"
                Padding="8"
                Background="{DynamicResource SalesDetailSurfaceEffectiveBrush}"
                BorderBrush="{DynamicResource SalesBorderEffectiveBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.Sales}"
                IsHitTestVisible="{Binding IsQueueDetailInteractive}"
                Visibility="{Binding IsQueueDetailPanelVisible, Converter={StaticResource BoolVisibility}}">
            <ScrollViewer x:Name="QueueDetailScroller"
                          MaxHeight="{Binding DetailMaxHeight}"
                          IsEnabled="{Binding IsQueueDetailInteractive}"
                          IsHitTestVisible="{Binding IsQueueDetailInteractive}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DetailItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Position}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" Foreground="{DynamicResource StatusLiveBrush}" Text="{Binding CurrentLabel}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Foreground="{DynamicResource ChatSelfMentionBrush}" Text="{Binding SelfLabel}" Visibility="{Binding IsSelf, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
