<Window x:Class="GachaOverlay.App.Presentation.ProductMappingManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
        Title="{Binding Localization[SettingsProductMappingManager]}"
        Icon="/GachaOverlay.App;component/Assets/Branding/GachaOverlay-AppIcon.ico"
        Width="1080" Height="720" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="MappingCard" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Localization[SettingsProductMappingManager]}" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductManagerDescription]}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.44*" MinWidth="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.56*" MinWidth="390" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MappingCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Localization[SettingsProductObservedEmoji]}" />
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Tag="{Binding Localization[SettingsProductSearch]}" Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ShowUnmappedOnly, Mode=TwoWay}" Content="{Binding Localization[SettingsProductUnmappedOnly]}" />
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredInventory}" SelectedItem="{Binding SelectedInventory, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding EmojiName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
                                        <Image Margin="3" Source="{Binding PreviewUrl}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding EmojiName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="ID " /><Run Text="{Binding EmojiId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UsageCount, Mode=OneWay}"/><Run Text="×"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource SurfaceSelectedBrush}" CornerRadius="4" Visibility="{Binding IsMapped, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding SourceText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Content="{Binding Localization[SettingsProductRefresh]}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MappingCard}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductSelectHelp]}" TextAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasSelectedInventory}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding CanCreateMapping, Converter={StaticResource BoolVisibility}}">
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding SelectedInventory.EmojiName}" />
                        <TextBlock Margin="0,5,0,18" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductNoMapping]}" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource Style.Button.Primary}" Command="{Binding AddSelectedCommand}" Content="{Binding Localization[SettingsProductCreateMapping]}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSelectedMapping, Converter={StaticResource BoolVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10">
                                <Image Margin="5" Source="{Binding SelectedInventory.PreviewUrl}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding SelectedMapping.EmojiName}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedMapping.EmojiId, StringFormat=Emoji ID: {0}}" />
                                <Border Margin="0,7,0,0" Padding="7,3" HorizontalAlignment="Left" Background="{DynamicResource SurfaceSelectedBrush}" CornerRadius="4">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding SelectedMapping.SourceText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,24,0,7" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductNameLabel]}" />
                        <TextBox x:Name="ProductNameTextBox" Text="{Binding SelectedMapping.ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductNameHint]}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,18,0,7" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductExistingNames]}" />
                        <ComboBox ItemsSource="{Binding ProductNameSuggestions}" SelectedItem="{Binding SelectedProductNameSuggestion, Mode=TwoWay}" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsProductGroupHint]}" TextWrapping="Wrap" />

                        <CheckBox Margin="0,22,0,0" IsChecked="{Binding SelectedMapping.Enabled, Mode=TwoWay}" Content="{Binding Localization[SettingsProductColumnEnabled]}" />
                        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" Visibility="{Binding IsDraftMapping, Converter={StaticResource BoolVisibility}}">
                            <Button Style="{StaticResource Style.Button.Primary}" Command="{Binding CommitDraftCommand}" Content="{Binding Localization[SettingsProductDraftSave]}" />
                            <Button Margin="8,0,0,0" Command="{Binding CancelDraftCommand}" Content="{Binding Localization[SettingsProductDraftCancel]}" />
                        </StackPanel>
                        <Button Margin="0,24,0,0" HorizontalAlignment="Left" Command="{Binding DeleteSelectedCommand}" Content="{Binding Localization[SettingsProductDeleteSelected]}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Destructive}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsDraftMapping}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding RestoreDefaultCommand}"
                                Content="{Binding Localization[SettingsProductRestoreDefault]}"
                                Visibility="{Binding CanRestoreDefault, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
            <Button Grid.Column="1" Style="{StaticResource Style.Button.Primary}" Command="{Binding SaveCommand}" Content="{Binding Localization[SettingsProductSaveApply]}" />
        </Grid>
    </Grid>
</Window>
