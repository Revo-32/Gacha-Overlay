<UserControl x:Class="GachaOverlay.App.Presentation.ChatMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- ChatNicknameBrush is the white no-role fallback; per-message role colors override it. -->
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="ReactionTemplate">
            <Border Margin="0,3,4,0"
                    Padding="5,2"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Image Width="14" Height="14" Source="{Binding Image}"
                           Stretch="Uniform"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Text}"
                               Visibility="{Binding ShowText, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Margin="4,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding Count}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ForwardMessageTemplate">
            <Border Margin="0,3,0,4"
                    Padding="8,6"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding Label}" />
                    <local:CrispOutlinedText Margin="0,3,0,0"
                                             Tokens="{Binding Tokens}"
                                             EmojiExtent="{Binding DataContext.EmojiExtent, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             FontFamily="{Binding DataContext.MessageFontFamily, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             FontSize="{Binding DataContext.FontSizeDip, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             FontWeight="{Binding DataContext.MessageFontWeight, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             Foreground="{DynamicResource ChatMessageBrush}"
                                             IsHitTestVisible="False"
                                             LineHeight="{Binding DataContext.LineHeight, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                             OutlineEnabled="{Binding DataContext.ShowMessageOutline, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             OutlineThickness="{Binding DataContext.MessageOutlineThickness, RelativeSource={RelativeSource AncestorType={x:Type local:ChatMessageView}}}"
                                             SelfMentionBackground="{DynamicResource ChatSelfMentionBackgroundBrush}"
                                             SelfMentionForeground="{DynamicResource ChatSelfMentionBrush}"
                                             TextWrapping="Wrap"
                                             Visibility="{Binding HasText, Converter={StaticResource BoolVisibility}}" />
                    <Image Width="{Binding StickerExtent}"
                           Height="{Binding StickerExtent}"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Left"
                           Source="{Binding StickerImage}"
                           Stretch="Uniform"
                           Visibility="{Binding ShowStickerImage, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding StickerFallbackText}"
                               Visibility="{Binding ShowStickerFallback, Converter={StaticResource BoolVisibility}}" />
                    <Grid Margin="0,5,0,0"
                          HorizontalAlignment="Left"
                          Visibility="{Binding ShowThumbnail, Converter={StaticResource BoolVisibility}}">
                        <Image Width="{Binding ThumbnailWidth}"
                               MaxHeight="{Binding ThumbnailMaxHeight}"
                               HorizontalAlignment="Left"
                               Source="{Binding Thumbnail}"
                               Stretch="Uniform" />
                        <Border Margin="0,0,4,4"
                                Padding="5,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource MediaOverlayBrush}"
                                CornerRadius="4"
                                Visibility="{Binding HasAdditionalMedia, Converter={StaticResource BoolVisibility}}">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding AdditionalMediaText}" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding MediaFallbackText}"
                               Visibility="{Binding ShowMediaFallback, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding DetailsText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasDetails, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{Binding MessageMargin}" ClipToBounds="False">
        <Border x:Name="MessageSurface"
                Padding="3,0,3,0"
                Background="Transparent"
                ClipToBounds="False"
                CornerRadius="4">
            <StackPanel ClipToBounds="False">
                <StackPanel Visibility="{Binding IsBalanced, Converter={StaticResource BoolVisibility}}">
                    <Grid ClipToBounds="False"
                          Visibility="{Binding ShowAuthorHeader, Converter={StaticResource BoolVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center"
                                       FontSize="{Binding FontSizeDip}" Text="{Binding RoleIconText}"
                                       Visibility="{Binding HasRoleIconText, Converter={StaticResource BoolVisibility}}" />
                            <Image Width="16" Height="16" Margin="0,0,4,0"
                                   Source="{Binding RoleIconImage}" Stretch="Uniform"
                                   Visibility="{Binding HasRoleIconImage, Converter={StaticResource BoolVisibility}}" />
                            <local:CrispOutlinedText x:Name="BalancedNickname"
                                                 FontFamily="{Binding NicknameFontFamily}"
                                                 FontSize="{Binding FontSizeDip}"
                                                 FontWeight="{Binding NicknameFontWeight}"
                                                 Foreground="{Binding NicknameBrush}"
                                                 IsHitTestVisible="False"
                                                 LineHeight="{Binding LineHeight}"
                                                 OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                                 OutlineEnabled="{Binding ShowNicknameOutline}"
                                                 OutlineThickness="{Binding NicknameOutlineThickness}"
                                                 Text="{Binding AuthorName}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{Binding MessageFontFamily}"
                                   FontSize="{Binding FontSizeDip, ConverterCulture=en-US}"
                                   FontWeight="{Binding MessageFontWeight}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding TimeText}"
                                   Visibility="{Binding ShowTime, Converter={StaticResource BoolVisibility}}" />
                    </Grid>

                    <TextBlock Margin="0,1,0,2"
                               FontFamily="{Binding MessageFontFamily}"
                               FontSize="{Binding FontSizeDip}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding ReplyText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasReply, Converter={StaticResource BoolVisibility}}" />
                    <local:CrispOutlinedText x:Name="BalancedBody"
                                             Tokens="{Binding Tokens}"
                                             EmojiExtent="{Binding EmojiExtent}"
                                             FontFamily="{Binding MessageFontFamily}"
                                             FontSize="{Binding FontSizeDip}"
                                             FontWeight="{Binding MessageFontWeight}"
                                             Foreground="{DynamicResource ChatMessageBrush}"
                                             IsHitTestVisible="False"
                                             LineHeight="{Binding LineHeight}"
                                             MaxHeight="{Binding MessageMaxHeight}"
                                             MentionBackground="{DynamicResource ChatMentionBackgroundBrush}"
                                             MentionForeground="{DynamicResource ChatMentionBrush}"
                                             OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                             OutlineEnabled="{Binding ShowMessageOutline}"
                                             OutlineThickness="{Binding MessageOutlineThickness}"
                                             SelfMentionBackground="{DynamicResource ChatSelfMentionBackgroundBrush}"
                                             SelfMentionForeground="{DynamicResource ChatSelfMentionBrush}"
                                             TextTrimming="CharacterEllipsis"
                                             TextWrapping="Wrap"
                                             Visibility="{Binding HasPrimaryText, Converter={StaticResource BoolVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ForwardedMessages}"
                                  ItemTemplate="{StaticResource ForwardMessageTemplate}" />
                    <local:ChatMediaView Visibility="{Binding HasVisibleMedia, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Margin="0,2,0,2"
                               FontFamily="{Binding MessageFontFamily}"
                               FontSize="{Binding FontSizeDip}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding RemoteDetailsText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasRemoteDetails, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>

                <Grid Visibility="{Binding IsCompact, Converter={StaticResource BoolVisibility}}"
                      ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0" Orientation="Horizontal"
                                Visibility="{Binding ShowAuthorHeader, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Margin="0,0,3,0" FontSize="{Binding FontSizeDip}" Text="{Binding RoleIconText}"
                                   Visibility="{Binding HasRoleIconText, Converter={StaticResource BoolVisibility}}" />
                        <Image Width="15" Height="15" Margin="0,0,3,0" Source="{Binding RoleIconImage}"
                               Visibility="{Binding HasRoleIconImage, Converter={StaticResource BoolVisibility}}" />
                        <local:CrispOutlinedText x:Name="CompactNickname"
                                             Grid.Column="0"
                                             FontFamily="{Binding NicknameFontFamily}"
                                             FontSize="{Binding FontSizeDip}"
                                             FontWeight="{Binding NicknameFontWeight}"
                                             Foreground="{Binding NicknameBrush}"
                                             IsHitTestVisible="False"
                                             LineHeight="{Binding LineHeight}"
                                             OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                             OutlineEnabled="{Binding ShowNicknameOutline}"
                                             OutlineThickness="{Binding NicknameOutlineThickness}"
                                             Text="{Binding AuthorName, StringFormat={}{0}:}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Margin="0,1,0,2"
                                   FontFamily="{Binding MessageFontFamily}"
                                   FontSize="{Binding FontSizeDip}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{Binding ReplyText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasReply, Converter={StaticResource BoolVisibility}}" />
                        <local:CrispOutlinedText x:Name="CompactBody"
                                                 Tokens="{Binding Tokens}"
                                                 EmojiExtent="{Binding EmojiExtent}"
                                                 FontFamily="{Binding MessageFontFamily}"
                                                 FontSize="{Binding FontSizeDip}"
                                                 FontWeight="{Binding MessageFontWeight}"
                                                 Foreground="{DynamicResource ChatMessageBrush}"
                                                 IsHitTestVisible="False"
                                                 LineHeight="{Binding LineHeight}"
                                                 MaxHeight="{Binding MessageMaxHeight}"
                                                 MentionBackground="{DynamicResource ChatMentionBackgroundBrush}"
                                                 MentionForeground="{DynamicResource ChatMentionBrush}"
                                                 OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                                 OutlineEnabled="{Binding ShowMessageOutline}"
                                                 OutlineThickness="{Binding MessageOutlineThickness}"
                                                 SelfMentionBackground="{DynamicResource ChatSelfMentionBackgroundBrush}"
                                                 SelfMentionForeground="{DynamicResource ChatSelfMentionBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 TextWrapping="Wrap"
                                                 Visibility="{Binding HasPrimaryText, Converter={StaticResource BoolVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ForwardedMessages}"
                                      ItemTemplate="{StaticResource ForwardMessageTemplate}" />
                        <local:ChatMediaView Visibility="{Binding HasVisibleMedia, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Margin="0,2,0,2"
                                   FontFamily="{Binding MessageFontFamily}"
                                   FontSize="{Binding FontSizeDip}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{Binding RemoteDetailsText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasRemoteDetails, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsUltraCompact, Converter={StaticResource BoolVisibility}}"
                      ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0" Orientation="Horizontal"
                                Visibility="{Binding ShowAuthorHeader, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Margin="0,0,3,0" FontSize="{Binding FontSizeDip}" Text="{Binding RoleIconText}"
                                   Visibility="{Binding HasRoleIconText, Converter={StaticResource BoolVisibility}}" />
                        <Image Width="15" Height="15" Margin="0,0,3,0" Source="{Binding RoleIconImage}"
                               Visibility="{Binding HasRoleIconImage, Converter={StaticResource BoolVisibility}}" />
                        <local:CrispOutlinedText x:Name="UltraCompactNickname"
                                             Grid.Column="0"
                                             FontFamily="{Binding NicknameFontFamily}"
                                             FontSize="{Binding FontSizeDip}"
                                             FontWeight="{Binding NicknameFontWeight}"
                                             Foreground="{Binding NicknameBrush}"
                                             IsHitTestVisible="False"
                                             LineHeight="{Binding LineHeight}"
                                             OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                             OutlineEnabled="{Binding ShowNicknameOutline}"
                                             OutlineThickness="{Binding NicknameOutlineThickness}"
                                             Text="{Binding AuthorName, StringFormat={}{0}:}"
                                             TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <local:CrispOutlinedText x:Name="UltraCompactBody"
                                             Grid.Column="1"
                                             Tokens="{Binding Tokens}"
                                             EmojiExtent="{Binding EmojiExtent}"
                                             FontFamily="{Binding MessageFontFamily}"
                                             FontSize="{Binding FontSizeDip}"
                                             FontWeight="{Binding MessageFontWeight}"
                                             Foreground="{DynamicResource ChatMessageBrush}"
                                             IsHitTestVisible="False"
                                             LineHeight="{Binding LineHeight}"
                                             MaxHeight="{Binding MessageMaxHeight}"
                                             MentionBackground="{DynamicResource ChatMentionBackgroundBrush}"
                                             MentionForeground="{DynamicResource ChatMentionBrush}"
                                             OutlineBrush="{DynamicResource ChatOutlineBrush}"
                                             OutlineEnabled="{Binding ShowMessageOutline}"
                                             OutlineThickness="{Binding MessageOutlineThickness}"
                                             SelfMentionBackground="{DynamicResource ChatSelfMentionBackgroundBrush}"
                                             SelfMentionForeground="{DynamicResource ChatSelfMentionBrush}"
                                             TextTrimming="CharacterEllipsis"
                                             TextWrapping="NoWrap"
                                             Visibility="{Binding HasPrimaryText, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Grid.Column="1"
                               FontFamily="{Binding MessageFontFamily}"
                               FontSize="{Binding FontSizeDip}"
                               Foreground="{DynamicResource ChatMessageBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding UltraCompactSummaryText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Visibility="{Binding ShowUltraCompactSummary, Converter={StaticResource BoolVisibility}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Reactions}"
                              ItemTemplate="{StaticResource ReactionTemplate}"
                              Visibility="{Binding HasReactions, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
