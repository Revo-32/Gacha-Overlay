<Window x:Class="GachaOverlay.App.Presentation.FoundationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
        xmlns:settings="clr-namespace:GachaOverlay.Core.Settings;assembly=GachaOverlay.Core"
        Title="{Binding Localization[AppName]}"
        Icon="/GachaOverlay.App;component/Assets/Branding/LSOverlay-AppIcon.ico"
        Width="980" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Closing="OnClosing">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <local:SliderValueTextConverter x:Key="SliderValueText" />
        <DataTemplate x:Key="OptionTemplate"><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
        <DataTemplate x:Key="RemoteDisplayNameTemplate"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,14,0,7"/>
        </Style>

        <DataTemplate x:Key="GeneralTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsGeneralTitle]}"/>
                <TextBlock FontWeight="SemiBold" Text="{Binding Localization[AppName]}"/>
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding Localization[SettingsAppVersion], Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AppVersionText, Mode=OneWay}"/></TextBlock>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsVisibilityMode]}"/>
                <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding VisibilityModes}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Mode" SelectedValue="{Binding SelectedVisibilityMode, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsColorTheme]}"/>
                <ItemsControl ItemsSource="{Binding ColorThemes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="280"
                                    MinHeight="112"
                                    Margin="0,0,10,10"
                                    Padding="14,12"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    Command="{Binding ApplyCommand}"
                                    Style="{StaticResource Style.PresetCardButton}"
                                    Tag="{Binding IsSelected}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Text="✓"
                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Margin="0,4,0,9" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Swatches}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Width="28" Height="12" Margin="0,0,5,0" Background="{Binding}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,28,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[TrayHint]}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding Localization[SettingsAutoSaveHint]}" TextWrapping="Wrap"/>
                <Button Margin="0,28,0,0" HorizontalAlignment="Left" Style="{StaticResource Style.Button.Destructive}" Command="{Binding ResetAllSettingsCommand}" Content="{Binding Localization[SettingsResetAll]}"/>
                <TextBlock Margin="0,9,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsResetAllHint]}" TextWrapping="Wrap"/>
                <CheckBox Margin="0,24,0,0" IsChecked="{Binding WindowsAutoStart, Mode=TwoWay}" Content="{Binding Localization[SettingsWindowsAutoStart]}" AutomationProperties.Name="{Binding Localization[SettingsWindowsAutoStart]}"/>
                <TextBlock Margin="28,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsWindowsAutoStartHint]}" TextWrapping="Wrap"/>
                <Button Margin="0,22,0,0" HorizontalAlignment="Left" Command="{Binding RerunOnboardingCommand}" Content="{Binding Localization[SettingsRerunOnboarding]}"/>
                <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsRerunOnboardingHint]}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DiscordTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsDiscordTitle]}"/>
                <TextBlock Margin="0,5,0,10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsRemoteDescription]}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Margin="0,0,8,8" Command="{Binding RemoteChatSettings.RefreshCommand}" Content="{Binding Localization[SettingsRemoteRefresh]}"/>
                    <Button Margin="0,0,8,8" Style="{StaticResource Style.Button.Primary}" Command="{Binding RemoteChatSettings.BeginLoginCommand}" Content="{Binding Localization[SettingsRemoteLogin]}" Visibility="{Binding RemoteChatSettings.NeedsLogin, Converter={StaticResource BoolVisibility}}"/>
                    <Button Margin="0,0,8,8" Command="{Binding RemoteChatSettings.CancelLoginCommand}" Content="{Binding Localization[SettingsRemoteLoginCancel]}"/>
                    <Button Margin="0,0,8,8" Style="{StaticResource Style.Button.Destructive}" Command="{Binding RemoteChatSettings.ForgetCredentialCommand}" Content="{Binding Localization[SettingsRemoteForget]}"/>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoBrush}" Text="{Binding RemoteChatSettings.HealthText}"/>
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding RemoteChatSettings.HealthDetailText}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding RemoteChatSettings.CredentialStatusText}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsRemoteChannel]}"/>
                <WrapPanel>
                    <ComboBox x:Name="RemoteChannelComboBox" Width="380" Margin="0,0,8,8" ItemsSource="{Binding RemoteChatSettings.Channels}" ItemTemplate="{StaticResource RemoteDisplayNameTemplate}" SelectedItem="{Binding RemoteChatSettings.SelectedChannel, Mode=TwoWay}"/>
                    <Button Margin="0,0,8,8" Command="{Binding RemoteChatSettings.SwitchChannelCommand}" Content="{Binding Localization[SettingsRemoteUseChannel]}"/>
                </WrapPanel>
                <TextBlock Margin="0,5,0,20" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding RemoteChatSettings.StatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HudTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsHudTitle]}"/>
                <CheckBox IsChecked="{Binding ShowGtaSession, Mode=TwoWay}" Content="{Binding Localization[SettingsShowGtaSession]}"/>
                <TextBlock Margin="28,4,0,8" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsShowGtaSessionHint]}" TextWrapping="Wrap"/>
                <TextBlock Margin="28,4,0,5" Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsSessionHost]}"/>
                <ComboBox Width="220" Margin="28,0,0,10" HorizontalAlignment="Left" IsEnabled="{Binding ShowGtaSession}" ItemsSource="{Binding SessionHostOptions}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedSessionHost, Mode=TwoWay}" AutomationProperties.Name="{Binding Localization[SettingsSessionHost]}"/>
                <CheckBox IsChecked="{Binding HudModifierDragEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsModifierDrag]}"/>
                <TextBlock Margin="0,9,0,8" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsTransparentHudHint]}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsSurfaceOpacity]}"/><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Tag="{Binding HudSurfaceOpacity, Converter={StaticResource SliderValueText}, ConverterParameter=Percent}" Value="{Binding HudSurfaceOpacity, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsHudChromeOpacity]}"/><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Tag="{Binding HudChromeOpacity, Converter={StaticResource SliderValueText}, ConverterParameter=Percent}" Value="{Binding HudChromeOpacity, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatSurfaceOpacity]}"/><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Tag="{Binding ChatSurfaceOpacity, Converter={StaticResource SliderValueText}, ConverterParameter=Percent}" Value="{Binding ChatSurfaceOpacity, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsSalesSurfaceOpacity]}"/><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Tag="{Binding SalesSurfaceOpacity, Converter={StaticResource SliderValueText}, ConverterParameter=Percent}" Value="{Binding SalesSurfaceOpacity, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsQueueDetailSurfaceOpacity]}"/><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Tag="{Binding QueueDetailSurfaceOpacity, Converter={StaticResource SliderValueText}, ConverterParameter=Percent}" Value="{Binding QueueDetailSurfaceOpacity, Mode=TwoWay}"/>
                <WrapPanel Margin="0,24,0,0"><Button Margin="0,0,8,8" Command="{Binding ResetHudPositionCommand}" Content="{Binding Localization[SettingsResetPosition]}"/><Button Margin="0,0,8,8" Command="{Binding ResetHudSizeCommand}" Content="{Binding Localization[SettingsResetSize]}"/><Button Margin="0,0,8,8" Command="{Binding CenterHudOnCurrentDisplayCommand}" Content="{Binding Localization[SettingsCenterCurrentDisplay]}"/></WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChatTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsChatTitle]}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsChatLivePreviewHint]}"/>
                <ItemsControl Margin="0,15,0,0" ItemsSource="{Binding ChatStylePresets}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Button Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Command="{Binding ApplyCommand}" Tag="{Binding IsSelected}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}"/></StackPanel><TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource StatusInfoBrush}" Text="{Binding FontName}"/></Grid></Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding ChatPresetStatusMessage}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatLayout]}"/><ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding ChatLayoutModes}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedChatLayoutMode, Mode=TwoWay}"/>
                <CheckBox Margin="0,12,0,0" IsChecked="{Binding ChatShowTime, Mode=TwoWay}" Content="{Binding Localization[SettingsChatShowTime]}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatMaxLines]}"/><ComboBox Width="180" HorizontalAlignment="Left" ItemsSource="{Binding ChatMaxLineOptions}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding ChatMaxLines, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatFont]}"/><ComboBox Width="340" HorizontalAlignment="Left" ItemsSource="{Binding ChatFontPresets}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedChatFontPreset, Mode=TwoWay}"/>
                <TextBlock Margin="0,7,0,0" FontFamily="{Binding SelectedChatFontPreviewFamily}" FontWeight="{Binding SelectedChatFontPreviewWeight}" Text="{Binding Localization[SettingsFontPreviewSample]}"/><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedChatFontNotice}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatFontSize]}"/><Slider Minimum="8" Maximum="32" TickFrequency="0.5" Tag="{Binding ChatFontSizePoints, Converter={StaticResource SliderValueText}, ConverterParameter=Points}" Value="{Binding ChatFontSizePoints, Mode=TwoWay}"/>
                <UniformGrid Columns="2" Margin="0,14,0,0"><CheckBox IsChecked="{Binding ChatNicknameOutlineEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsNicknameOutline]}"/><CheckBox IsChecked="{Binding ChatMessageOutlineEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsMessageOutline]}"/></UniformGrid>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsNicknameOutlineThickness]}"/><Slider Minimum="0" Maximum="10" TickFrequency="0.25" IsSnapToTickEnabled="True" Tag="{Binding ChatNicknameOutlineThickness, Converter={StaticResource SliderValueText}, ConverterParameter=DipDecimal}" Value="{Binding ChatNicknameOutlineThickness, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsMessageOutlineThickness]}"/><Slider Minimum="0" Maximum="10" TickFrequency="0.25" IsSnapToTickEnabled="True" Tag="{Binding ChatMessageOutlineThickness, Converter={StaticResource SliderValueText}, ConverterParameter=DipDecimal}" Value="{Binding ChatMessageOutlineThickness, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatLineHeight]}"/><Slider Minimum="1.0" Maximum="1.65" TickFrequency="0.05" IsSnapToTickEnabled="True" Tag="{Binding ChatLineHeightMultiplier, Converter={StaticResource SliderValueText}}" Value="{Binding ChatLineHeightMultiplier, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsChatMessageSpacing]}"/><Slider Minimum="-2" Maximum="48" TickFrequency="0.25" IsSnapToTickEnabled="True" Tag="{Binding ChatMessageSpacing, Converter={StaticResource SliderValueText}, ConverterParameter=Dip}" Value="{Binding ChatMessageSpacing, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsRoleIconPosition]}"/><ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding RoleIconPositions}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedRoleIconPosition, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsReactionSize]}"/><Slider Minimum="14" Maximum="42" TickFrequency="1" IsSnapToTickEnabled="True" Tag="{Binding ChatReactionSize, Converter={StaticResource SliderValueText}, ConverterParameter=Dip}" Value="{Binding ChatReactionSize, Mode=TwoWay}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsMediaTitle]}"/>
                <CheckBox IsChecked="{Binding ChatShowImages, Mode=TwoWay}" Content="{Binding Localization[SettingsShowImages]}"/><CheckBox Margin="0,12,0,0" IsChecked="{Binding ChatCustomEmojiEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsCustomEmoji]}"/><CheckBox Margin="0,12,0,0" IsChecked="{Binding ChatStickerEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsStickers]}"/><CheckBox Margin="0,12,0,0" IsChecked="{Binding HidePreviewSourceUrl, Mode=TwoWay}" Content="{Binding Localization[SettingsHidePreviewSourceUrl]}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsImageSize]}"/><ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding ChatImageSizeModes}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedChatImageSizeMode, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsShowImages]}"/><ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding ChatImageModes}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedChatImageMode, Mode=TwoWay}"/>
                <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsMediaFirstPlusNHint]}" TextWrapping="Wrap"/>
                <Button Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding ClearMediaCacheCommand}" Content="{Binding Localization[SettingsClearMediaCache]}"/>
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding MediaCacheStatusMessage}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SalesTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsSalesTitle]}"/><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsSalesDescription]}" TextWrapping="Wrap"/>
                <CheckBox Margin="0,16,0,0" IsChecked="{Binding SalesTrackingEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsSalesTracking]}"/>
                <UniformGrid Columns="2" Margin="0,16,0,0" IsEnabled="{Binding SalesDisplayOptionsEnabled}"><CheckBox Margin="0,0,0,9" IsChecked="{Binding SalesShowCurrentSeller, Mode=TwoWay}" Content="{Binding Localization[SettingsSalesShowCurrentSeller]}"/><CheckBox Margin="0,0,0,9" IsChecked="{Binding SalesShowWaitingCount, Mode=TwoWay}" Content="{Binding Localization[SettingsSalesShowWaitingCount]}"/><CheckBox IsChecked="{Binding SalesShowProduct, Mode=TwoWay}" Content="{Binding Localization[SettingsSalesShowProduct]}"/><CheckBox IsChecked="{Binding SalesShowNextWaitingUser, Mode=TwoWay}" Content="{Binding Localization[SettingsSalesShowNextWaitingUser]}"/></UniformGrid>
                <Border Margin="0,22,0,0" Padding="14" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding SalesTurnSoundEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsSalesTurnSound]}"/>
                        <TextBlock Margin="28,4,0,8" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsSalesTurnSoundHint]}" TextWrapping="Wrap"/>
                        <UniformGrid Columns="2" IsEnabled="{Binding SalesTurnSoundOptionsEnabled}">
                            <CheckBox IsChecked="{Binding NotifySalesNext, Mode=TwoWay}" Content="{Binding Localization[SettingsNotifySalesNext]}"/>
                            <CheckBox IsChecked="{Binding NotifySalesCurrent, Mode=TwoWay}" Content="{Binding Localization[SettingsNotifySalesCurrent]}"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsSalesTurnSoundVolume]}"/>
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding SalesTurnSoundOptionsEnabled}" Tag="{Binding SalesTurnSoundVolume, Converter={StaticResource SliderValueText}, ConverterParameter=Percent100}" Value="{Binding SalesTurnSoundVolume, Mode=TwoWay}"/>
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding TestSalesTurnSoundCommand}" Content="{Binding Localization[SettingsTestSalesTurnSound]}"/>
                    </StackPanel>
                </Border>
                <Border Margin="0,22,0,0" Padding="14" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding SalesHealthText}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SalesCoverageText}"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SalesLastFullSyncText}"/></StackPanel></Border>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsQueueDetailMaxHeight]}"/><Slider Minimum="120" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="True" Tag="{Binding SalesQueueDetailMaxHeight, Converter={StaticResource SliderValueText}, ConverterParameter=Dip}" Value="{Binding SalesQueueDetailMaxHeight, Mode=TwoWay}"/>
                <Button Margin="0,24,0,0" HorizontalAlignment="Left" Style="{StaticResource Style.Button.Primary}" Command="{Binding ManualSalesResyncCommand}" Content="{Binding Localization[SettingsManualSalesResync]}"/>
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding ManualSalesResyncStatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SalesHistoryTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsSalesHistoryTitle]}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsSalesHistoryDescription]}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding Localization[SettingsSalesHistoryRecent]}"/>
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding SalesHistory.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                <TextBlock Grid.Column="1" Margin="18,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LastSoldText}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="0,20,0,0" HorizontalAlignment="Left" Style="{StaticResource Style.Button.Destructive}" Command="{Binding SalesHistory.ResetCommand}" Content="{Binding Localization[SettingsSalesHistoryReset]}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HotkeysTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsCategoryHotkeys]}"/><CheckBox IsChecked="{Binding HudModifierDragEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsModifierDrag]}"/><TextBlock Margin="28,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsModifierDragHint]}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsVisibilityHotkey]}"/><TextBox Text="{Binding VisibilityHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsLockHotkey]}"/><TextBox Text="{Binding LockHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsHotkeyHint]}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsPreviousChannel]}"/>
                <TextBox Text="{Binding PreviousChannelHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsNextChannel]}"/>
                <TextBox Text="{Binding NextChannelHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="0,8,0,12" Text="{Binding Localization[SettingsChannelHotkeyHint]}" TextWrapping="Wrap"/>
                <StackPanel Margin="0,18,0,0" Orientation="Horizontal"><Button Command="{Binding ApplyHotkeysCommand}" Content="{Binding Localization[SettingsApplyHotkeys]}"/><Button Margin="8,0,0,0" Command="{Binding ResetHotkeysCommand}" Content="{Binding Localization[SettingsResetHotkeys]}"/></StackPanel><TextBlock Margin="0,10,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding HotkeyValidationMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TimersTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsTimerTitle]}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsTimerDescription]}" TextWrapping="Wrap"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Localization[SettingsTimerGeneral]}"/>
                    <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding GeneralTimerPresets}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Minutes" SelectedValue="{Binding GeneralTimerMinutes, Mode=TwoWay}"/>
                    <TextBox Grid.Column="2" Text="{Binding GeneralTimerHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Localization[SettingsTimerBunker]}"/>
                    <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding BunkerTimerPresets}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Minutes" SelectedValue="{Binding BunkerTimerMinutes, Mode=TwoWay}"/>
                    <TextBox Grid.Column="2" Text="{Binding BunkerTimerHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Localization[SettingsTimerLsd]}"/>
                    <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding LsdTimerPresets}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Minutes" SelectedValue="{Binding LsdTimerMinutes, Mode=TwoWay}"/>
                    <TextBox Grid.Column="2" Text="{Binding LsdTimerHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsTimerHotkeyHint]}" TextWrapping="Wrap"/>
                <CheckBox Margin="0,18,0,0" IsChecked="{Binding TimerCompletionSoundEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsTimerCompletionSound]}"/>
                <Button Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding ApplyHotkeysCommand}" Content="{Binding Localization[SettingsApplyHotkeys]}"/>
                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding HotkeyValidationMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticsTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsDiagnosticsTitle]}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsDiagnosticsDescription]}"/>
                <TextBlock Margin="0,18,0,0" FontWeight="SemiBold"><Run Text="{Binding Localization[SettingsAppVersion], Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AppVersionText, Mode=OneWay}"/></TextBlock>
                <TextBlock Margin="0,8,0,0" Text="{Binding RemoteChatSettings.HealthText}"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding RemoteChatSettings.CredentialStatusText}"/>
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding SalesEffectiveSourceText}"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding SalesRemoteStatusText}"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding SalesMergedStatusText}"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding SalesHealthText}"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding SalesCoverageText}"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding SalesLastFullSyncText}"/>
                <WrapPanel Margin="0,20,0,0"><Button Margin="0,0,8,8" Command="{Binding OpenLogFolderCommand}" Content="{Binding Localization[SettingsOpenLogFolder]}"/><Button Margin="0,0,8,8" Command="{Binding OpenLatestLogCommand}" Content="{Binding Localization[SettingsOpenLatestLog]}"/></WrapPanel>
                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Style.Button.Primary}" Command="{Binding ManualSalesResyncCommand}" Content="{Binding Localization[SettingsManualSalesResync]}"/>
                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding RemoteChatSettings.RefreshCommand}" Content="{Binding Localization[SettingsRemoteRefresh]}"/>
                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding ClearMediaCacheCommand}" Content="{Binding Localization[SettingsClearMediaCache]}"/>
                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding ResetHudPlacementCommand}" Content="{Binding Localization[SettingsResetPlacement]}"/>
                <Button Margin="0,28,0,0" HorizontalAlignment="Left" Style="{StaticResource Style.Button.Destructive}" Command="{Binding ResetAllSettingsCommand}" Content="{Binding Localization[SettingsResetAll]}"/>
                <TextBlock Margin="0,24,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsDiagnosticBundleDescription]}" TextWrapping="Wrap"/>
                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Style.Button.Primary}" Command="{Binding CreateDiagnosticBundleCommand}" Content="{Binding Localization[SettingsCreateDiagnosticBundle]}"/>
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding DiagnosticExportStatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GtaCompanionTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsGtaCompanionTitle]}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsGtaCompanionDescription]}" TextWrapping="Wrap"/>
                <CheckBox Margin="0,18,0,0" IsChecked="{Binding GtaCompanionEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsGtaCompanionMaster]}"/>
                <Border Margin="0,16,0,0" Padding="14" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Localization[SettingsGtaCompanionSections]}"/>
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding GtaCompanionDailyEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsGtaCompanionDaily]}"/>
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding GtaCompanionWeeklyEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsGtaCompanionWeekly]}"/>
                        <CheckBox Margin="0,10,0,0" IsChecked="{Binding GtaCompanionWeeklyEventsEnabled, Mode=TwoWay}" Content="{Binding Localization[SettingsGtaCompanionEvents]}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsGtaCompanionCompactHint]}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsSurfaceOpacity]}"/>
                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Tag="{Binding GtaCompanionSurfaceOpacity, Converter={StaticResource SliderValueText}, ConverterParameter=Percent}"
                        Value="{Binding GtaCompanionSurfaceOpacity, Mode=TwoWay}"/>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsGtaCompanionHotkey]}"/>
                <TextBox Text="{Binding GtaCompanionVisibilityHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsGtaCompanionHotkeyHint]}" TextWrapping="Wrap"/>
                <Button Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding ApplyHotkeysCommand}" Content="{Binding Localization[SettingsApplyHotkeys]}"/>
                <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding HotkeyValidationMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DeveloperTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Localization[SettingsDeveloperTitle]}"/>
                <Expander Header="{Binding Localization[SettingsAdvancedConnection]}" Margin="0,0,0,16">
                    <StackPanel>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding Localization[SettingsRemoteEndpoint]}"/>
                <TextBox Width="480" HorizontalAlignment="Left" Text="{Binding RemoteChatSettings.BackendBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button HorizontalAlignment="Left" Margin="0,8,0,8" Command="{Binding RemoteChatSettings.ApplyConfigurationCommand}" Content="{Binding Localization[SettingsRemoteApply]}"/>
                        <CheckBox IsChecked="{Binding MinimalHudMode, Mode=TwoWay}" Content="{Binding Localization[SettingsMinimalHud]}"/>
                    </StackPanel>
                </Expander>

                <Border Padding="16" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Localization[SettingsDeveloperProductMapping]}"/>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsDeveloperProductDescription]}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,14,0,0" Text="{Binding ProductCatalogSummaryText}"/>
                        <TextBlock Margin="0,5,0,0" Text="{Binding ProductOverrideCountText}"/>
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding ProductCatalogLoadStatusText}"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Margin="0,0,8,8" Command="{Binding OpenProductMappingManagerCommand}" Content="{Binding Localization[SettingsProductMappingManager]}"/>
                            <Button Margin="0,0,8,8" Command="{Binding ExportProductMappingsCommand}" Content="{Binding Localization[SettingsDeveloperExportEffective]}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource Style.Button.Destructive}" Command="{Binding ResetProductOverridesCommand}" Content="{Binding Localization[SettingsDeveloperResetOverrides]}" Visibility="{Binding HasProductOverrides, Converter={StaticResource BoolVisibility}}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Localization[SettingsDeveloperSalesTest]}"/>
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsDeveloperSalesTestDescription]}" TextWrapping="Wrap"/>
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenSalesPreviewCommand}" Content="{Binding Localization[SettingsSalesPreview]}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Localization[SettingsDeveloperApplicationInfo]}"/>
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="LS Overlay"/>
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding Localization[SettingsAppVersion], Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AppVersionText, Mode=OneWay}"/></TextBlock>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Margin="0,0,8,8" Command="{Binding ShowCreditsCommand}" Content="{Binding Localization[SettingsDeveloperCredits]}"/>
                            <Button Margin="0,0,8,8" Command="{Binding OpenLicenseNoticesCommand}" Content="{Binding Localization[SettingsDeveloperLicenses]}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18"><Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="18"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="22,18,22,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Width="32" Height="32" Margin="0,0,12,0" Source="/GachaOverlay.App;component/Assets/Branding/LSOverlay-AppIcon.png"/><TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{Binding Localization[SettingsTitle]}"/><ComboBox x:Name="LanguageComboBox" Visibility="Collapsed" ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage}"/><ComboBox x:Name="VisibilityModeComboBox" Visibility="Collapsed" ItemsSource="{Binding VisibilityModes}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Value" SelectedValue="{Binding SelectedVisibilityMode}"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" Margin="0,0,18,0" ItemsSource="{Binding SettingsCategories}" SelectedValuePath="Value" SelectedValue="{Binding SelectedSettingsCategory, Mode=TwoWay}" SelectionChanged="OnCategorySelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" Data="{Binding Icon}" Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Text="{Binding DisplayText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Background="{DynamicResource BorderSubtleBrush}"/>
            <ScrollViewer x:Name="CategoryScrollViewer" Grid.Column="2" Margin="24,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource GeneralTemplate}"/><Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Discord}"><Setter Property="ContentTemplate" Value="{StaticResource DiscordTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Hud}"><Setter Property="ContentTemplate" Value="{StaticResource HudTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Chat}"><Setter Property="ContentTemplate" Value="{StaticResource ChatTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Media}"><Setter Property="ContentTemplate" Value="{StaticResource MediaTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Sales}"><Setter Property="ContentTemplate" Value="{StaticResource SalesTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.SalesHistory}"><Setter Property="ContentTemplate" Value="{StaticResource SalesHistoryTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Timers}"><Setter Property="ContentTemplate" Value="{StaticResource TimersTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.GtaCompanion}"><Setter Property="ContentTemplate" Value="{StaticResource GtaCompanionTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Hotkeys}"><Setter Property="ContentTemplate" Value="{StaticResource HotkeysTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Diagnostics}"><Setter Property="ContentTemplate" Value="{StaticResource DiagnosticsTemplate}"/></DataTrigger><DataTrigger Binding="{Binding SelectedSettingsCategory}" Value="{x:Static settings:SettingsCategory.Developer}"><Setter Property="ContentTemplate" Value="{StaticResource DeveloperTemplate}"/></DataTrigger>
            </Style.Triggers></Style></ContentControl.Style></ContentControl></ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Margin="22,16,22,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Localization[SettingsChatLivePreviewHint]}"/><Button Grid.Column="1" Command="{Binding HideToTrayCommand}" Content="{Binding Localization[HideToTray]}"/></Grid>
    </Grid></Border></Grid>
</Window>
