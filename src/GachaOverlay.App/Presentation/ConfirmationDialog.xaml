<Window x:Class="GachaOverlay.App.Presentation.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" FontSize="15" Text="{Binding Message}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="90" Margin="0,0,8,0" IsCancel="True" Content="{Binding CancelText}"/>
            <Button MinWidth="90" Style="{StaticResource Style.Button.Destructive}" IsDefault="True"
                    Click="OnConfirm" Content="{Binding ConfirmText}"/>
        </StackPanel>
    </Grid>
</Window>
