<Window x:Class="GachaOverlay.App.Presentation.GtaCompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
        Title="GTA 컴패니언" Width="360" Height="470" MinWidth="300" MinHeight="180"
        AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" WindowStyle="None"
        Closing="OnClosing" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="DailyChallengeOptionTemplate">
            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </Window.Resources>
    <Border x:Name="Surface" Padding="10" BorderThickness="1" CornerRadius="11">
        <DockPanel>
            <Border x:Name="DragHandle" DockPanel.Dock="Top" Width="26" Height="20" Margin="0,0,0,3"
                    HorizontalAlignment="Right" Background="Transparent" CornerRadius="5"
                    IsHitTestVisible="{Binding IsInteractive}" MouseLeftButtonDown="OnDragMouseLeftButtonDown"
                    ToolTip="창 이동">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Text="⠿"/>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource GtaCompanionCardSurfaceBrush}" CornerRadius="7"
                            Visibility="{Binding ShowDaily, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <Grid><TextBlock FontWeight="SemiBold" Text="일일 도전"/><TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DailyResetText}"/></Grid>
                            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding DailySlots}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                                            <ComboBox Grid.Column="1" Margin="4,0" MaxDropDownHeight="280" IsEnabled="{Binding IsInteractive}"
                                                      ItemsSource="{Binding Options}" ItemTemplate="{StaticResource DailyChallengeOptionTemplate}"
                                                      TextSearch.TextPath="DisplayText" SelectedValuePath="ChallengeId"
                                                      SelectedValue="{Binding SelectedChallengeId, Mode=TwoWay}"/>
                                            <CheckBox Grid.Column="2" Margin="5,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsInteractive}" IsChecked="{Binding Completed, Mode=TwoWay}" Content="완료"/>
                                        </Grid>
                                        <TextBox Margin="48,3,0,0" MaxLength="160" IsEnabled="{Binding IsInteractive}" Text="{Binding CustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsCustom, Converter={StaticResource BoolVisibility}}" ToolTip="도전 내용을 직접 입력하세요."/>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource GtaCompanionCardSurfaceBrush}" CornerRadius="7"
                            Visibility="{Binding ShowWeekly, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <Grid><TextBlock FontWeight="SemiBold" Text="주간 도전"/><TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding WeeklyResetText}"/></Grid>
                            <TextBlock Margin="0,5,0,0" Text="{Binding WeeklyChallengeText}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding WeeklyRewardText}" TextWrapping="Wrap"/>
                            <CheckBox Margin="0,5,0,0" IsEnabled="{Binding IsInteractive}" IsChecked="{Binding WeeklyCompleted, Mode=OneWay}" Command="{Binding ToggleWeeklyCompletionCommand}" Content="완료"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding ShowWeeklyEvents, Converter={StaticResource BoolVisibility}}">
                        <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource GtaCompanionCardSurfaceBrush}" CornerRadius="7">
                            <StackPanel><TextBlock FontWeight="SemiBold" Text="이번 주 보너스 · 할인 · 이벤트"/>
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding WeeklyEventItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,1" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Padding="8" Background="{DynamicResource GtaCompanionCardSurfaceBrush}" CornerRadius="7"
                                Visibility="{Binding HasCampaign, Converter={StaticResource BoolVisibility}}">
                            <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding CampaignTitle}"/>
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding CampaignItems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,1" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
