<Window x:Class="GachaOverlay.App.Presentation.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
        Title="{Binding Settings.Localization[OnboardingTitle]}"
        Icon="/GachaOverlay.App;component/Assets/Branding/GachaOverlay-AppIcon.ico"
        Width="760" Height="620" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="OptionTemplate"><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
        <DataTemplate x:Key="RemoteDisplayNameTemplate"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Settings.Localization[OnboardingTitle]}" />
            <TextBlock Margin="0,7,0,20" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StepProgressText}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="24" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding IsLanguageStep, Converter={StaticResource BoolVisibility}}">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Settings.Localization[OnboardingLanguageTitle]}" />
                        <TextBlock Margin="0,7,0,20" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Settings.Localization[OnboardingLanguageHint]}" TextWrapping="Wrap" />
                        <ComboBox Width="280" HorizontalAlignment="Left" ItemsSource="{Binding Settings.Languages}" ItemTemplate="{StaticResource OptionTemplate}" SelectedValuePath="Code" SelectedValue="{Binding Settings.SelectedLanguage, Mode=TwoWay}" AutomationProperties.Name="{Binding Settings.Localization[Language]}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsDiscordStep, Converter={StaticResource BoolVisibility}}">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Settings.Localization[OnboardingDiscordTitle]}" />
                        <TextBlock Margin="0,7,0,14" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Settings.Localization[OnboardingDiscordHint]}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,5" Text="{Binding Settings.Localization[SettingsRemoteEndpoint]}" />
                        <TextBox Text="{Binding Settings.RemoteChatSettings.BackendBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Margin="0,0,8,8" Command="{Binding Settings.RemoteChatSettings.ApplyConfigurationCommand}" Content="{Binding Settings.Localization[SettingsRemoteApply]}" />
                            <Button Margin="0,0,8,8" Command="{Binding Settings.RemoteChatSettings.RefreshCommand}" Content="{Binding Settings.Localization[SettingsRemoteRefresh]}" />
                            <Button Margin="0,0,8,8" Style="{StaticResource Style.Button.Primary}" Command="{Binding Settings.RemoteChatSettings.BeginPairingCommand}" Content="{Binding Settings.Localization[SettingsRemotePair]}" Visibility="{Binding Settings.RemoteChatSettings.NeedsLogin, Converter={StaticResource BoolVisibility}}" />
                            <Button Margin="0,0,8,8" Command="{Binding Settings.RemoteChatSettings.CancelPairingCommand}" Content="{Binding Settings.Localization[SettingsRemotePairCancel]}" />
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoBrush}" Text="{Binding Settings.RemoteChatSettings.HealthText}" />
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Settings.RemoteChatSettings.HealthDetailText}" TextWrapping="Wrap" />
                        <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="6" Visibility="{Binding Settings.RemoteChatSettings.HasPairingCode, Converter={StaticResource BoolVisibility}}">
                            <StackPanel><TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Settings.RemoteChatSettings.PairingCode}"/><TextBlock Margin="0,5,0,0" Text="{Binding Settings.RemoteChatSettings.PairingInstruction}" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <TextBlock Margin="0,12,0,5" Text="{Binding Settings.Localization[SettingsRemoteChannel]}" />
                        <WrapPanel>
                            <ComboBox Width="400" Margin="0,0,8,8" ItemsSource="{Binding Settings.RemoteChatSettings.Channels}" ItemTemplate="{StaticResource RemoteDisplayNameTemplate}" SelectedItem="{Binding Settings.RemoteChatSettings.SelectedChannel, Mode=TwoWay}" />
                            <Button Margin="0,0,8,8" Command="{Binding Settings.RemoteChatSettings.SwitchChannelCommand}" Content="{Binding Settings.Localization[SettingsRemoteUseChannel]}" />
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding Settings.RemoteChatSettings.StatusMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsHudStep, Converter={StaticResource BoolVisibility}}">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Settings.Localization[OnboardingHudTitle]}" />
                        <TextBlock Margin="0,7,0,18" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Settings.Localization[OnboardingHudHint]}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5" Text="F9 · HUD Show / Hide" />
                        <TextBlock Margin="0,5" Text="F10 · Lock / Unlock" />
                        <TextBlock Margin="0,5" Text="{Binding Settings.Localization[OnboardingHudDragHint]}" />
                        <TextBlock Margin="0,5" Text="{Binding Settings.Localization[OnboardingHudClickThroughHint]}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Command="{Binding PreviousCommand}" Content="{Binding Settings.Localization[OnboardingBack]}" />
                <Button Margin="0,0,8,0" Style="{StaticResource Style.Button.Primary}" Command="{Binding NextCommand}" Content="{Binding Settings.Localization[OnboardingNext]}" />
                <Button Style="{StaticResource Style.Button.Primary}" Command="{Binding FinishCommand}" Content="{Binding Settings.Localization[OnboardingFinish]}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
