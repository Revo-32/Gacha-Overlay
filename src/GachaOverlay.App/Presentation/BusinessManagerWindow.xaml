<Window x:Class="GachaOverlay.App.Presentation.BusinessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
        Title="사업장 관리자" Width="460" Height="520" MinWidth="420" MinHeight="180"
        AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" WindowStyle="None"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="OnClosing" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="BusinessRowText" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="EditRoot">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <!-- Nonzero alpha lets the existing native resize hit-test receive edge/corner input. -->
                    <DataTrigger Binding="{Binding IsInteractive}" Value="True">
                        <Setter Property="Background" Value="#01000000"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
    <Border x:Name="Surface" Padding="7" BorderThickness="1" CornerRadius="11">
        <DockPanel>
            <Border x:Name="DragGrip" DockPanel.Dock="Top" Width="26" Height="17" Margin="0,0,0,1"
                    HorizontalAlignment="Right" Background="Transparent" CornerRadius="5"
                    IsHitTestVisible="{Binding IsInteractive}" MouseLeftButtonDown="OnDragMouseLeftButtonDown"
                    ToolTip="창 이동">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" Text="⠿"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Margin="0,3,0,0" Padding="4,2" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGeneralTimerAttentionActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                <DockPanel>
                    <TextBlock FontWeight="SemiBold" Text="일반 타이머"/>
                    <TextBlock Margin="8,0,0,0" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding GeneralTimerStatus}"/>
                </DockPanel>
                <UniformGrid Margin="0,2,0,0" Columns="3"
                             Visibility="{Binding IsInteractive, Converter={StaticResource BoolVisibility}}">
                    <Button Margin="1" MinHeight="22" Padding="5,1" Command="{Binding StartGeneral12Command}" Content="12분"/>
                    <Button Margin="1" MinHeight="22" Padding="5,1" Command="{Binding StartGeneral24Command}" Content="24분"/>
                    <Button Margin="1" MinHeight="22" Padding="5,1" Command="{Binding StartGeneral48Command}" Content="48분"/>
                </UniformGrid>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Margin="0,0,0,3" Padding="6,4" Background="{DynamicResource BusinessCardSurfaceBrush}" CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                                <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Padding="2,1" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAttentionActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock MaxWidth="190" VerticalAlignment="Center"
                                                           Text="{Binding Label}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BusinessRowText}">
                                                            <Setter Property="MinWidth" Value="112"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHardTrackingRow}" Value="True">
                                                                    <Setter Property="MinWidth" Value="0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StatusErrorBrush}"
                                                           Text="{Binding AvailabilityAccentText}"
                                                           Visibility="{Binding HasAvailabilityAccent, Converter={StaticResource BoolVisibility}}"/>
                                                <TextBlock MinWidth="80" MaxWidth="200" Margin="4,0"
                                                           Style="{StaticResource BusinessRowText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Status}" TextWrapping="Wrap"/>
                                                <Button Margin="1,0" MinHeight="22" Padding="5,1" VerticalAlignment="Center"
                                                        Command="{Binding PrimaryCommand}" Content="{Binding PrimaryLabel}"
                                                        Visibility="{Binding IsInteractive, Converter={StaticResource BoolVisibility}}"/>
                                                <Button Margin="1,0" MinHeight="22" Padding="5,1" VerticalAlignment="Center"
                                                        Command="{Binding SecondaryCommand}" Content="{Binding SecondaryLabel}"
                                                        Visibility="{Binding CanUseSecondary, Converter={StaticResource BoolVisibility}}"/>
                                                <Button Margin="1,0" MinHeight="22" Padding="5,1" VerticalAlignment="Center"
                                                        Command="{Binding StopCommand}" Content="취소"
                                                        Visibility="{Binding CanStop, Converter={StaticResource BoolVisibility}}"/>
                                            </WrapPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
        <Border x:Name="EditOutline" Margin="1" BorderThickness="1" CornerRadius="9"
                BorderBrush="{DynamicResource AccentPrimaryBrush}" IsHitTestVisible="False"
                Visibility="{Binding IsInteractive, Converter={StaticResource BoolVisibility}}"/>
    </Grid>
</Window>
