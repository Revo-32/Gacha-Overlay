<Window x:Class="GachaOverlay.App.Presentation.SalesPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GachaOverlay.App.Presentation"
        Title="{Binding Localization[SettingsSalesPreview]}"
        Icon="/GachaOverlay.App;component/Assets/Branding/GachaOverlay-AppIcon.ico"
        Width="760" Height="430" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="ScenarioComboBox" Width="260" ItemsSource="{Binding Scenarios}" SelectedValuePath="Value" SelectedValue="{Binding SelectedScenario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="18" VerticalAlignment="Center" Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14">
            <local:SalesQueueView x:Name="PreviewView" DataContext="{Binding Sales}"/>
        </Border>
    </Grid>
</Window>
