# Allow only the Backend build graph into the context (not the entire checkout).
**
!Dockerfile
!.dockerignore
!global.json
!Directory.Build.props
# Do not allow the src parent: directory exceptions also include descendants.
# Re-include only complete required project trees, including their source assets.
!src/GachaOverlay.Core/
!src/GachaOverlay.Core/**
!src/LSOverlay.Protocol/
!src/LSOverlay.Protocol/**
!src/LSOverlay.Backend/
!src/LSOverlay.Backend/**
!assets/branding/LS_Overlay_logo.png

# Re-exclude generated output and any accidental runtime/secret files in source.
**/bin/**
**/obj/**
**/.git/**
**/.gitignore
**/.vs/**
**/.vscode/**
**/.idea/**
**/tmp/**
**/temp/**
**/state/**
**/data/**
**/publish/**
**/artifacts/**
**/TestResults/**
**/Logs/**
**/logs/**
**/.env*
**/*credentials*.json
**/*secret*.json
**/*secret*.txt
**/*token.dat
**/*.dat
**/*.log
**/*.trx
**/*.csv
**/*.bak
**/*.tmp
**/*.zip
**/*.7z
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/appsettings.*.json
**/appsettings.json
**/*audit*.json
