    { "area": "authoritative Sales window", "limit": 30, "unit": "messages", "source": "AuthoritativeSalesWindow.Size" },
    { "area": "Sales tombstones", "limit": 256, "unit": "records", "source": "SalesStateEngine.DefaultTombstoneLimit" },
    { "area": "active Chat channels", "limit": 16, "unit": "channels", "source": "ActiveChatStreamRegistry.MaximumActiveChannels" },
    { "area": "Chat bootstrap", "limit": 20, "unit": "messages", "source": "ActiveChatStreamRegistry.BootstrapMessageLimit" },
    { "area": "Chat journal", "limit": 128, "unit": "events per active channel", "source": "ActiveChatStreamRegistry.JournalCapacity" },
    { "area": "Chat outbound queue", "limit": 256, "unit": "events per subscriber", "source": "ActiveChatStreamRegistry.OutboundCapacity" },
    { "area": "Sales journal", "limit": 256, "unit": "events", "source": "ActiveSalesStreamRegistry.JournalCapacity" },
    { "area": "Sales outbound queue", "limit": 256, "unit": "events per subscriber", "source": "ActiveSalesStreamRegistry.OutboundCapacity" },
    { "area": "Remote publication journal", "limit": 2048, "unit": "events", "source": "RemotePublicationHub.DefaultJournalCapacity" },
    { "area": "Remote publication outbound queue", "limit": 256, "unit": "events per subscriber", "source": "RemotePublicationHub.DefaultOutboundCapacity" },
    { "area": "Backend event journal", "limit": 2048, "unit": "events", "source": "BackendEventJournal.DefaultCapacity" },
    { "area": "Remote client staged Chat events", "limit": 256, "unit": "events per pending switch; at most 5 pending switches", "source": "LSOverlayRemoteClient.TransactionalChatSwitchState.MaximumStagedEvents" },
    { "area": "Remote client staged Sales events", "limit": 256, "unit": "events", "source": "LSOverlayRemoteClient.TransactionalSalesState.MaximumStagedEvents" },
    { "area": "canonical refresh coalescer", "limit": 256, "unit": "message IDs", "source": "CanonicalMessageRefreshCoalescer.MaximumPendingMessages" },
    { "area": "canonical author cache", "limit": 512, "unit": "members", "source": "CanonicalRemoteAuthorResolver.MaximumCacheEntries" },
    { "area": "display-name cache", "limit": 512, "unit": "members", "source": "GuildDisplayNameResolver.DefaultMaximumEntries" },
    { "area": "pairing table", "limit": 64, "unit": "active pairings", "source": "PairingService.MaximumActivePairings" },
    { "area": "client credential registry", "limit": 128, "unit": "credentials", "source": "ClientCredentialRegistry.MaximumCredentials" },
    { "area": "Remote global connections", "limit": 64, "unit": "connections", "source": "RemoteConnectionLimiter.DefaultGlobalLimit" },
    { "area": "Remote per-installation connections", "limit": 2, "unit": "connections", "source": "RemoteConnectionLimiter.DefaultPerInstallationLimit" },
    { "area": "Sales action dedupe", "limit": 256, "unit": "requests", "source": "RemoteSalesActionService.DedupeCapacity" },
    { "area": "Sales action versions", "limit": 256, "unit": "messages", "source": "RemoteSalesActionService.VersionCapacity" },
    { "area": "Sales action rate", "limit": 8, "unit": "requests per minute", "source": "RemoteSalesActionService.MaximumRequestsPerMinute" },
    { "area": "configured session hosts", "limit": 2, "unit": "host slots", "source": "BackendConfiguration.MaximumSessionHosts" },
    { "area": "emoji image cache", "limit": 64, "unit": "bitmaps", "source": "DiscordMediaAssetService" },
    { "area": "thumbnail image cache", "limit": 24, "unit": "bitmaps", "source": "DiscordMediaAssetService" },
    { "area": "sticker image cache", "limit": 24, "unit": "bitmaps", "source": "DiscordMediaAssetService" },
    { "area": "single media download", "limit": 12582912, "unit": "bytes", "source": "DiscordMediaAssetService.MaximumBytes" },
    { "area": "inbound WebSocket message", "limit": 16384, "unit": "bytes", "source": "OverlayTransportProtocol.MaximumInboundWebSocketBytes" },
    { "area": "runtime duration samples", "limit": 256, "unit": "samples per fixed metric name", "source": "RuntimeMetrics.DefaultDurationSampleCapacity" },
    { "area": "media outstanding loaders including retired generations", "limit": 112, "unit": "64 emoji + 24 thumbnails + 24 stickers; bounded admission, no extra queue", "source": "BoundedAsyncCache._outstandingLoads" },
    { "area": "media failure cooldowns", "limit": 112, "unit": "64 + 24 + 24 keys", "source": "BoundedAsyncCache.TrimFailureCooldowns" },
    { "area": "media HTTP header and body deadline", "limit": 10, "unit": "seconds per request, excluding synchronous decode", "source": "DiscordMediaAssetService.DownloadAsync" },
    { "area": "WPF per-connection auxiliary requests", "limit": 3, "unit": "one each: channel switch, Sales resync, Sales action", "source": "RemoteRequestScope" },
    { "area": "WPF channel switch and Sales resync queues", "limit": 1, "unit": "bootstrap per queue; DropOldest", "source": "RemoteChatProductionCoordinator" },
    { "area": "WPF Sales action failure/pending presentation", "limit": 30, "unit": "current authoritative message identities; pruned on replacement", "source": "SalesQueueViewModel.ApplyRemoteStatusContext" },
    { "area": "Guild membership cache", "limit": 128, "unit": "confirmed member/non-member results; transient unavailable is not cached", "source": "DiscordGuildMembershipVerifier" },
    { "area": "Chat authorization leases and outstanding refreshes", "limit": 128, "unit": "each; excess refresh fails closed", "source": "ChatAuthorizationService.MaximumLeases" },
    { "area": "Backend outstanding Sales actions", "limit": 256, "unit": "including operations evicted from dedupe and awaiting gate", "source": "RemoteSalesActionService._outstandingActions" },
    { "area": "Sales rate windows", "limit": 128, "unit": "users, each at most 8 timestamps", "source": "RemoteSalesActionService.RateWindowCapacity" },
    { "area": "Sales action stripe gates", "limit": 64, "unit": "process-owned SemaphoreSlim; asynchronous only, no WaitHandle accessed", "source": "RemoteSalesActionService.GateStripeCount" },
    { "area": "WPF diagnostic nickname selection samples", "limit": 32, "unit": "keys", "source": "DiscordMessagePipeline._loggedNameSelections" }
  ]
}
